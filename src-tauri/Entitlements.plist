<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used when the macOS app is signed. Signing turns on the hardened
     runtime, which refuses the Apple events WattClean sends Finder (through
     osascript) to count and empty the Trash and to move removed programs
     and their leftovers there, with no prompt, unless this is granted. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
